vim.pack.add({
	{ src = "https://github.com/obsidian-nvim/obsidian.nvim", version = vim.version.range("*") },
})

require("obsidian").setup({
	legacy_commands = false, -- goes away in 4.0.0 anyway, skip the deprecated :Obsidian* commands
	workspaces = {
		{{- if hasKey . "work" }}
		{ name = "{{ .work.name | upper }}", path = "~/Documents/{{ .work.name | upper }}" },
{{- end }}
	},
	picker = { name = "fzf-lua" },
})

-- ui features (checkboxes, link hiding) need conceallevel 1 or 2, else the
-- plugin warns on every markdown buffer
vim.api.nvim_create_autocmd("FileType", {
	pattern = "markdown",
	callback = function()
		vim.opt_local.conceallevel = 2
	end,
})

vim.keymap.set("n", "<leader>o", "<cmd>Obsidian quick_switch<cr>", { desc = "Obsidian: find note" })
