"$schema" = "https://jj-vcs.github.io/jj/latest/config-schema.json"

# ──────────────────────────────────────────────────────────────
# IDENTITY
# ──────────────────────────────────────────────────────────────

[user]
name  = "Matan"
email = "matan.amidor@proton.me"

# Work repos get the work address. --when.repositories matches by path
# prefix, so anything under this directory picks it up.
[[--scope]]
--when.repositories = ["{{ .chezmoi.homeDir }}/code/{{ if hasKey . "work" }}{{ .work.dir }}{{ else }}__none__{{ end }}"]
[--scope.user]
email = "{{ if hasKey . "work" }}{{ .work.email }}{{ else }}{{ .email }}{{ end }}"

# ──────────────────────────────────────────────────────────────
# REMOTE SETTINGS
#
# auto-track-bookmarks only mirrors matching remote branches into
# local bookmarks on fetch. Keep it at 'main': '*' mirrors every
# branch on origin and leaves a pile of stale local bookmarks behind.
#
# Your own new bookmarks don't need tracking set up. `jj push -b <name>`
# (or --named <name>=<rev>) tracks them for you on the first push.
# ──────────────────────────────────────────────────────────────

[remotes.origin]
auto-track-bookmarks = 'main'

# ──────────────────────────────────────────────────────────────
# UI & EDITOR
# ──────────────────────────────────────────────────────────────

[ui]
editor         = "{{ .chezmoi.homeDir }}/.config/jj/scripts/jj-editor.sh"
diff-formatter = "difft"         # use difftastic for side-by-side diffs
diff-editor    = ":builtin"      # interactive staging uses jj's own TUI
merge-editor   = "vimdiff3"

# Run `jj log` when you type `jj` with no arguments.
default-command = "log"

paginate                  = "auto"
log-synthetic-elided-nodes = true   # shows "~ (elided)" lines in the graph
graph.style               = "square"

# "snapshot" conflict style: shows what each side looked like before
# the conflict, rather than a diff of the changes. Easier to read
# when both sides modified the same block heavily.
conflict-marker-style = "snapshot"

# ──────────────────────────────────────────────────────────────
# COLOURS — Everforest, light soft. Matches ghostty's
# "Everforest Light Soft" theme and nvim's sainnhe/everforest
# (background=light, everforest_background=soft), so all three
# render identically instead of jj falling back to whatever ANSI
# palette a given terminal ships.
# ──────────────────────────────────────────────────────────────

[colors]
"error" = { fg = "#5C6A72", bold = true }
"error_source" = { fg = "#5C6A72" }
"warning" = { fg = "#5C6A72", bold = true }
"hint" = { fg = "#5C6A72" }
"error heading" = { fg = "#F85552", bold = true }
"error_source heading" = { bold = true }
"warning heading" = { fg = "#DFA000", bold = true }
"hint heading" = { fg = "#35A77C", bold = true }

"conflict_description" = "#DFA000"
"conflict_description difficult" = "#F85552"

"commit_id" = "#3A94C5"
"change_id" = "#DF69BA"

"prefix" = { bold = true }
"rest" = "#939F91"
"change_offset" = { bold = true }
"hidden prefix" = "#5C6A72"

"author" = "#DFA000"
"committer" = "#DFA000"
