"working_copy" = { bold = true }
"working_copy commit_id" = "#3A94C5"
"working_copy change_id" = "#DF69BA"
"working_copy author" = "#DFA000"
"working_copy committer" = "#DFA000"
"working_copy timestamp" = "#35A77C"
"working_copy working_copies" = "#8DA101"
"working_copy bookmark" = "#DF69BA"
"working_copy bookmarks" = "#DF69BA"
"working_copy local_bookmarks" = "#DF69BA"
"working_copy remote_bookmarks" = "#DF69BA"
"working_copy tag" = "#DF69BA"
"working_copy tags" = "#DF69BA"
"working_copy git_ref" = "#8DA101"
"working_copy divergent" = "#DF69BA"
"working_copy mutable divergent" = "#F85552"
"working_copy mutable divergent change_id" = "#F85552"
"working_copy conflict" = "#F85552"
"working_copy empty" = "#8DA101"
