"$schema" = "https://jj-vcs.github.io/jj/latest/config-schema.json"

[user]
name  = "{{ .name }}"
email = "{{ .email }}"

# path prefix match, so every repo under smarttrackers gets the work address
[[--scope]]
--when.repositories = ["{{ .chezmoi.homeDir }}/code/{{ if hasKey . "work" }}{{ .work.dir }}{{ else }}__none__{{ end }}"]
[--scope.user]
email = "{{ if hasKey . "work" }}{{ .work.email }}{{ else }}{{ .email }}{{ end }}"

# '*' mirrors every branch on origin and leaves a pile of stale local bookmarks
[remotes.origin]
auto-track-bookmarks = 'main'

[ui]
editor          = "{{ .chezmoi.homeDir }}/.config/jj/scripts/jj-editor.sh"
diff-formatter  = ":git"
diff-editor     = ":builtin"
merge-editor    = "vimdiff3"
default-command = "log"
graph.style     = "square"
# each side as it was before, easier to read than a diff when both sides rewrote the same block
conflict-marker-style = "snapshot"

# Stock modus-operandi, so jj matches ghostty and nvim instead of the terminal's ANSI palette.
# The "working_copy X" rules aren't redundant: jj ships bright defaults for each, and those would win.
[colors]
"error" = { fg = "#000000", bold = true }
"error_source" = { fg = "#000000" }
"warning" = { fg = "#000000", bold = true }
"hint" = { fg = "#000000" }
"error heading" = { fg = "#a60000", bold = true }
"error_source heading" = { bold = true }
"warning heading" = { fg = "#6f5500", bold = true }
"hint heading" = { fg = "#005e8b", bold = true }

"conflict_description" = "#6f5500"
"conflict_description difficult" = "#a60000"

"commit_id" = "#0031a9"
"change_id" = "#721045"

"prefix" = { bold = true }
"rest" = "#595959"
"change_offset" = { bold = true }
"hidden prefix" = "#000000"

"author" = "#6f5500"
"committer" = "#6f5500"
"timestamp" = "#005e8b"
"working_copies" = "#006800"
"workspace_name" = "#006800"
"bookmark" = "#721045"
"bookmarks" = "#721045"
"local_bookmarks" = "#721045"
"remote_bookmarks" = "#721045"
"tag" = "#721045"
"tags" = "#721045"
"git_ref" = "#006800"
"divergent" = "#721045"
"mutable divergent" = "#a60000"
"mutable divergent change_id" = "#a60000"
"conflict" = "#a60000"
"empty" = "#006800"
"placeholder" = "#a60000"
"description placeholder" = "#6f5500"
"empty description placeholder" = "#006800"
"separator" = "#595959"
"elided" = "#595959"
"root" = "#006800"

"working_copy" = { bold = true }
"working_copy commit_id" = "#0031a9"
"working_copy change_id" = "#721045"
"working_copy author" = "#6f5500"
"working_copy committer" = "#6f5500"
"working_copy timestamp" = "#005e8b"
"working_copy working_copies" = "#006800"
"working_copy bookmark" = "#721045"
"working_copy bookmarks" = "#721045"
"working_copy local_bookmarks" = "#721045"
"working_copy remote_bookmarks" = "#721045"
"working_copy tag" = "#721045"
"working_copy tags" = "#721045"
"working_copy git_ref" = "#006800"
"working_copy divergent" = "#721045"
"working_copy mutable divergent" = "#a60000"
"working_copy mutable divergent change_id" = "#a60000"
"working_copy conflict" = "#a60000"
"working_copy empty" = "#006800"
"working_copy placeholder" = "#a60000"
"working_copy description placeholder" = "#6f5500"
"working_copy empty description placeholder" = "#006800"

"config_list name" = "#006800"
"config_list value" = "#6f5500"
"config_list source" = "#0031a9"
"config_list path" = "#721045"
"config_list overridden" = "#595959"
"config_list overridden name" = "#595959"
"config_list overridden value" = "#595959"
"config_list overridden source" = "#595959"
"config_list overridden path" = "#595959"

"diff header" = "#6f5500"
"diff empty" = "#005e8b"
"diff binary" = "#005e8b"
"diff file_header" = { bold = true }
"diff hunk_header" = "#005e8b"
"diff context line_number" = { dim = true }
"diff removed" = { fg = "#a60000" }
"diff added" = { fg = "#006800" }
"diff token" = { underline = true }
"diff modified" = "#005e8b"
"diff untracked" = "#721045"
"diff renamed" = "#005e8b"
"diff copied" = "#006800"
"diff access-denied" = { bg = "#a60000" }
# modus bg_removed / bg_added, bg only so syntax keeps its colours, text holds 16:1
"diff removed token" = { bg = "#ffd8d5", underline = false }
"diff added token"   = { bg = "#c1f2d1", underline = false }

"operation id" = "#0031a9"
"operation user" = "#6f5500"
"operation time" = "#005e8b"
"operation attributes" = "#721045"
"operation current_operation" = { bold = true }
"operation current_operation id" = "#0031a9"
"operation current_operation user" = "#6f5500"
"operation current_operation time" = "#005e8b"
"operation current_operation attributes" = "#721045"

"node elided" = { fg = "#595959" }
"node working_copy" = { fg = "#006800", bold = true }
"node current_operation" = { fg = "#006800", bold = true }
"node immutable" = { fg = "#005e8b", bold = true }
"node conflicted" = { fg = "#a60000", bold = true }

# delta as the pager, not the diff-formatter. As a formatter it gets two temp dirs,
# so every file reads "renamed from left/..." and --context stops working.
# color = "never" because delta drops its own highlighting on lines jj already coloured.
# log stays out: the graph prefix stops delta spotting the diff. delta's styling is in ~/.gitconfig [delta].
[[--scope]]
--when.commands = ["diff", "show", "evolog", "interdiff"]
[--scope.ui]
pager = ["delta"]
color = "never"

# jjui captures output instead of paging, and sets DFT_WIDTH itself
[merge-tools.difft]
diff-args = ["--color=always", "--context=8", "$left", "$right"]

[snapshot]
auto-update-stale = true

[revset-aliases]
# every address I've committed under, the builtin mine() only matches the current user.email
{{- $es := list .email }}{{ if hasKey . "gitEmails" }}{{ $es = .gitEmails }}{{ end }}
'me()' = '{{ range $i, $e := $es }}{{ if $i }} | {{ end }}author_email(exact:"{{ $e }}"){{ end }}'

# Everything connected to @ through mutable commits, plus two commits below so the fork off trunk shows.
# Not filtered by author: a teammate's fixup on top would turn my stack into someone else's head.
'stack()' = 'ancestors(reachable(@, mutable()), 2)'

'recent()' = 'committer_date(after:"1 month ago")'

[revsets]
# my stack in full, one row per bookmark touched this month, and trunk. `jj wip` shows the stale ones too.
log = 'present(@) | stack() | (bookmarks() & mutable() & recent()) | trunk()'
bookmark-advance-to = "@-"
short-prefixes = "(trunk()..@)::"

[template-aliases]
'format_short_change_id(id)' = 'id.shortest()'

[aliases]
nt = ["new", "trunk()"]

d   = ["diff", "--context", "8"]
s   = ["show", "--context", "8"]
dt  = ["diff", "--tool", "difft"]     # structural, for refactors where the line diff is all noise
ds  = ["diff", "--context", "8", "--config", "ui.pager=['delta','--side-by-side']"]  # wants a wide terminal
la  = ["log", "-r", "all()"]
lm  = ["log", "-r", "me()"]
lt  = ["log", "-r", "trunk()..@ | trunk()"]
wip = ["log", "-r", "trunk()..(me() & visible_heads())"]  # every stack of mine, not just the one @ is on
lteam = ["log", "-r", "ancestors(visible_heads() & recent(), 2)"]

c   = ["commit"]
ci  = ["commit", "--interactive"]
si  = ["squash", "--interactive"]
m   = ["describe", "-m"]
abs = ["absorb"]
evo = ["evolog"]

nb = ["bookmark", "create", "-r", "@-"]

pull = ["git", "fetch"]

# A bare push only moves tracked bookmarks, so a new one needs -b <name>.
# Starts ci-watch in the background once something actually went out.
push = ["util", "exec", "--", "sh", "-c", """
  output=$(jj git push "$@" 2>&1)
  status=$?
  echo "$output"
  if [ "$status" -ne 0 ]; then exit "$status"; fi
  case "$output" in *"Nothing changed"*) exit 0 ;; esac
  nohup ~/.config/jj/scripts/ci-watch.sh >/dev/null 2>&1 &
""", "jj-push"]

retrunk = ["rebase", "-o", "trunk()"]  # the whole branch, rebase defaults to -b @
rebase-all = ["rebase", "-s", "all:roots(trunk()..mutable())", "-o", "trunk()"]  # every stack in the repo

# targets @, or @- when @ is empty and undescribed
fixup = ["util", "exec", "--", "{{ .chezmoi.homeDir }}/.config/jj/scripts/jj-fixup.sh"]

# matched by subject, on the stack @ is on. Pass a revset to widen it, 'mutable()' for the whole repo.
squash-fixups = ["util", "exec", "--", "{{ .chezmoi.homeDir }}/.config/jj/scripts/jj-squash-fixups.sh"]
sf = ["squash-fixups"]

# jj edit refuses when the text matches more than one commit, rather than guessing
edesc = ["util", "exec", "--", "sh", "-c", """
  jj edit -r "mutable() & description(substring-i:\\"$1\\")"
""", "jj-edesc"]

# gh pr create for the single bookmark between trunk and @, extra flags pass through
pr = ["util", "exec", "--", "sh", "-c", """
  bookmarks=$(jj log --no-graph -r 'heads(::@ & bookmarks() ~ trunk())' -T 'bookmarks.map(|b| b.name()).join("\\n")') && \
  count=$(echo "$bookmarks" | grep -c .) && \
  if [ "$count" -eq 0 ]; then echo "No bookmark found between trunk and @" >&2; exit 1; fi && \
  if [ "$count" -gt 1 ]; then echo "Multiple bookmarks found, pass one explicitly:" >&2; echo "$bookmarks" >&2; exit 1; fi && \
  gh pr create --head "$bookmarks" "$@"
""", "jj-pr"]

[signing]
key = "{{ .chezmoi.homeDir }}/.ssh/tempi_sign.pub"
