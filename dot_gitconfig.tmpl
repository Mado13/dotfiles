[user]
	name = {{ .name }}
	email = {{ .email }}
[diff]
  external = difft
[difftool "difftastic"]
  # See `man git-difftool` for a description of MERGED, LOCAL and REMOTE.
  cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"
[difftool]
    # Run the difftool immediately, don't ask 'are you sure' each time.
    prompt = false
[pager]
    # Use a pager if the difftool output is larger than one screenful,
    # consistent with the behaviour of `git diff`.
    difftool = true
[diff]
    # Set difftastic as the default difftool, so we don't need to specify
    # `-t difftastic` every time.
    tool  = difftastic
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  undo = reset --soft HEAD^1
  ri = rebase -i main
	rc = rebase --continue
	amend = commit --amend --no-edit
	fix = "!f() { git commit --fixup=${1:-HEAD}; }; f"
	fwl = push --force-with-lease
	recent = diff HEAD~1
[help]
	autocorrect = 20
[merge]
	conflictstyle = diff3
	autostash = true
	tool = meld
[rebase]
	autostash = true
[push]
    	default = current
    	autoSetupRemote = true
[commit]
	verbose = true
[core]
    editor = nvim
	excludesFile = {{ .chezmoi.homeDir }}/.config/git/ignore
[rerere]
	enabled = true
[init]
	defaultBranch = main
[absorb]
	oneFixupPerCommit = true
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
	provider = generic
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true

[delta]
	syntax-theme = GitHub
	line-numbers = true
	navigate = true
	hunk-header-style = file line-number syntax
	file-style = bold
	file-decoration-style = "#595959 ul"
	hunk-header-decoration-style = "#595959 ul"
	hunk-header-line-number-style = "#0031a9"
	# modus bg_removed / bg_added, with the faint variants for whole-line and the
	# solid ones for the changed words. All stock modus, nothing derived.
	minus-style = "syntax #ffe9e9"
	minus-emph-style = "syntax #ffd8d5"
	plus-style = "syntax #d8f8e1"
	plus-emph-style = "syntax #c1f2d1"
	line-numbers-minus-style = "#a60000"
	line-numbers-plus-style = "#006800"
	line-numbers-zero-style = "#9f9f9f"
	whitespace-error-style = "#a60000 reverse"
	max-line-length = 0
