# Includes must come before any Host block to apply everywhere.
Include ~/.orbstack/ssh/config
Include {{ .chezmoi.homeDir }}/.colima/ssh_config

# Work hosts live outside this repo, it is public. See the README.
Include ~/.ssh/config.work

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

Host codeberg.org
  AddKeysToAgent yes
  UseKeychain yes
  HostName codeberg.org
  User git
  IdentityFile ~/.ssh/proton_key
  IdentitiesOnly yes

Host gitlab.com
  AddKeysToAgent yes
  UseKeychain yes
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/tempi_sign
  IdentitiesOnly yes
